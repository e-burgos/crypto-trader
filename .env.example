# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — validated at startup.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public"

# ── Seeding ───────────────────────────────────────────────────────────────────
# `prisma db seed` always provisions reference data (agents, LLM providers, data
# sources). The demo logins are provisioned only outside production. Set to
# "false" to skip them in a non-production environment; with NODE_ENV=production
# they are never provisioned and this flag cannot re-enable them.
SEED_DEMO_ACCOUNTS="true"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — the API refuses to start without it. There is no fallback secret.
JWT_SECRET="<generate-with: openssl rand -hex 64>"
# REQUIRED — the API refuses to start without it. There is no fallback secret.
JWT_REFRESH_SECRET="<generate-with: openssl rand -hex 64>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED — validated at startup.
# Must be exactly 32 characters for AES-256 encryption of Binance/LLM API keys
BINANCE_KEY_ENCRYPTION_KEY="replace-with-32-char-secret-key!"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:4200"

# ── Binance API URLs ──────────────────────────────────────────────────────────
# Override Binance endpoints (useful for geo-restricted regions like US)
# Public data (klines, ticker) — no geo-restrictions:
BINANCE_PUBLIC_URL="https://data-api.binance.vision"
# Authenticated requests (orders, account) — may be geo-restricted:
BINANCE_BASE_URL="https://api.binance.com"

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used by Vite (apps/web). Must be VITE_API_URL — NOT VITE_API_BASE_URL
VITE_API_URL="http://localhost:3000/api"

# ── Embeddings (RAG / Orchestrator) ──────────────────────────────────────────
# The provider is chosen EXPLICITLY and never falls back on its own. Vectors from
# different models live in different vector spaces: a cosine similarity between a
# Voyage vector and an OpenAI one is meaningless even at the same length. A silent
# fallback would keep indexing while quietly making new chunks incomparable with
# everything already stored, and retrieval would degrade with nothing in the logs.
#
# CHANGING EITHER OF THESE TWO MEANS RE-EMBEDDING EVERY STORED CHUNK.
#
# 'openrouter' (default) | 'voyage' | 'openai'
EMBEDDING_PROVIDER=openrouter
# Must produce 1024 dimensions — the length every stored chunk already has.
# NOTHING IN THE DATABASE ENFORCES IT: the embedding column is jsonb and accepts
# any length silently (migration 20260413184109 dropped the pgvector column).
# text-embedding-3-* are Matryoshka models, so the service asks for dimensions=1024
# and gets it natively, no client-side truncation.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Required by EMBEDDING_PROVIDER=openrouter. Same account as the agent chat keys,
# but a SEPARATE setting: embeddings are platform infrastructure, not a per-user
# decision. The per-user OpenRouter key lives encrypted in llm_credentials.
OPEN_ROUTER_API_KEY="<openrouter-api-key>"
# Required by EMBEDDING_PROVIDER=voyage (voyage-3, 1024 dims natively).
VOYAGE_API_KEY="<voyage-ai-api-key>"
# Required by EMBEDDING_PROVIDER=openai. The service passes dimensions=1024, so it
# fits the column; without that parameter text-embedding-3-small returns 1536.
OPENAI_API_KEY="<openai-api-key>"

# Number of reverse proxy hops in front of the API (Railway, nginx, Cloudflare…).
# Leave unset or 0 when the API is reachable directly: trusting hops that do not
# exist lets a client forge X-Forwarded-For and pick its own rate-limit bucket.
# Railway sits behind a single edge proxy, so production wants 1.
TRUST_PROXY_HOPS=0
