      "trading_configs": {
        "module": "trading-agents-core",
        "spec": "sdd/specs/spec-e-burgos-001-agents-simplification",
        "status": "updated",
        "created_in_cycle": 2,
        "updated_in_cycle": 3,
        "migration_file": "apps/api/prisma/migrations/20260817150000_add_trading_config_risk_tools/migration.sql",
        "columns": {
          "id": {
            "type": "String @id @default(cuid())",
            "constraints": ["PRIMARY KEY"]
          },
          "user_id": {
            "type": "String",
            "constraints": ["NOT NULL", "FK users(id) ON DELETE CASCADE"]
          },
          "name": {
            "type": "String @default(\"\")",
            "constraints": ["NOT NULL"]
          },
          "asset": {
            "type": "Asset",
            "constraints": ["NOT NULL"],
            "notes": "BTC | ETH"
          },
          "pair": {
            "type": "QuoteCurrency",
            "constraints": ["NOT NULL"],
            "notes": "USDT | USDC"
          },
          "buy_threshold": {
            "type": "Float @default(70)",
            "constraints": ["NOT NULL"]
          },
          "sell_threshold": {
            "type": "Float @default(70)",
            "constraints": ["NOT NULL"]
          },
          "stop_loss_pct": {
            "type": "Float @default(0.03)",
            "constraints": ["NOT NULL"]
          },
          "take_profit_pct": {
            "type": "Float @default(0.05)",
            "constraints": ["NOT NULL"],
            "notes": "cycle-02: queda desactivado mientras trailing_stop_enabled sea true (el trailing lo reemplaza)"
          },
          "min_profit_pct": {
            "type": "Float @default(0.003)",
            "constraints": ["NOT NULL"],
            "notes": "cycle-02: deja de ser veto absoluto del SELL y pasa a ser el piso del camino de toma de ganancia"
          },
          "max_trade_pct": {
            "type": "Float @default(0.05)",
            "constraints": ["NOT NULL"],
            "notes": "cycle-02: pasa a ser TECHO del sizing, nunca superable"
          },
          "max_concurrent_positions": {
            "type": "Int @default(2)",
            "constraints": ["NOT NULL"]
          },
          "min_interval_minutes": {
            "type": "Int @default(5)",
            "constraints": ["NOT NULL"]
          },
          "interval_mode": {
            "type": "IntervalMode @default(AGENT)",
            "constraints": ["NOT NULL"]
          },
          "order_price_offset_pct": {
            "type": "Float @default(0)",
            "constraints": ["NOT NULL"]
          },
          "mode": {
            "type": "TradingMode @default(SANDBOX)",
            "constraints": ["NOT NULL"]
          },
          "is_running": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "cycle-02: el gate de riesgo agregado puede ponerlo en false para todas las configs del usuario al cruzar el drawdown"
          },
          "risk_profile": {
            "type": "RiskProfile @default(MODERATE)",
            "constraints": ["NOT NULL"]
          },
          "loss_cut_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: interruptor del corte de perdida por senal. false = veto actual intacto"
          },
          "loss_cut_confidence_threshold": {
            "type": "Float @default(0.85)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: confianza minima (0..1) del agente para vender en perdida"
          },
          "loss_cut_min_loss_pct": {
            "type": "Float @default(0.005)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: perdida minima para considerar el corte; evita churn por ruido"
          },
          "loss_cut_min_edge_ratio": {
            "type": "Float @default(2)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: multiplo de la friccion de salida (simulateTrade con stopLossPct 0) que la perdida evitada debe superar"
          },
          "smart_sizing_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: habilita la modulacion del tamano por AEGIS/FORGE. false = balance x maxTradePct fijo"
          },
          "reduce_size_factor": {
            "type": "Float @default(0.5)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: factor aplicado cuando el verdict de AEGIS es REDUCE"
          },
          "native_protection_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: coloca OCO real al abrir posicion. Solo LIVE/TESTNET; se ignora en SANDBOX"
          },
          "close_on_protection_failure": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: opt-in agresivo, cierra a mercado si la proteccion no se pudo colocar tras 3 reintentos"
          },
          "stop_limit_offset_pct": {
            "type": "Float @default(0.002)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: distancia entre stopPrice y el price limite de la pierna STOP_LOSS_LIMIT"
          },
          "trailing_stop_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02"
          },
          "trailing_stop_pct": {
            "type": "Float @default(0.02)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: distancia del stop bajo el maximo visto"
          },
          "trailing_activation_pct": {
            "type": "Float @default(0.01)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: ganancia no realizada minima para empezar a trailear"
          },
          "partial_tp_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02"
          },
          "partial_tp_trigger_pct": {
            "type": "Float @default(0.02)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02"
          },
          "partial_tp_sell_pct": {
            "type": "Float @default(0.5)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: fraccion de la posicion vendida en el parcial"
          },
          "move_stop_to_breakeven_after_partial": {
            "type": "Boolean @default(true)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-02: solo se evalua dentro de la rama partial_tp_enabled, que nace apagada"
          },
          "max_position_hold_minutes": {
            "type": "Int",
            "constraints": ["NULL"],
            "notes": "NUEVO cycle-02: null = salida por tiempo apagada"
          },
          "created_at": {
            "type": "DateTime @default(now())",
            "constraints": ["NOT NULL"]
          },
          "updated_at": {
            "type": "DateTime @updatedAt",
            "constraints": ["NOT NULL"]
          },
          "deterministic_gate_enabled": {
            "type": "Boolean @default(false)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-03: interruptor del gate determinista pre-LLM. Nace apagado (RN-04): una instalacion existente que despliegue este ciclo sin tocar su config llama al LLM en todo ciclo, igual que antes. Es per-config porque la activacion es explicita del dueno del bot"
          },
          "gate_price_change_pct": {
            "type": "Float @default(0.005)",
            "constraints": ["NOT NULL"],
            "notes": "NUEVO cycle-03: umbral de cambio significativo de precio de la condicion 3 del gate (default 0.5%). Unico umbral del gate que es per-config; los otros cuatro (banda RSI 40-60, delta RSI 5, edad de snapshot 5 min, edad de decision previa 90 min) son constantes de libs/analysis. DTO: @Min(0.0005) @Max(0.05) en Create y Update o el request entero responde 400"
          }
        },
        "indexes": [
          {
            "name": "pk_trading_configs",
            "type": "PRIMARY",
            "columns": ["id"]
          }
        ],
        "changelog": [
          {
            "cycle": 2,
            "date": "2026-08-17",
            "migration": "20260817150000_add_trading_config_risk_tools",
            "change": "tabla pre-existente registrada en el arnes; se agregan 15 columnas (politica de corte de perdida por senal, sizing modulado, proteccion nativa, trailing, TP parcial y salida por tiempo). Todos los defaults reproducen el comportamiento actual: ninguna instalacion existente cambia de conducta sin configurar"
          },
          {
            "cycle": 3,
            "date": "2026-08-17",
            "migration": "20260817160000_add_cost_gate_fields",
            "change": "cycle-03: 2 columnas para el gate determinista pre-LLM (deterministic_gate_enabled, gate_price_change_pct). El interruptor nace apagado; el default de umbral reproduce el comportamiento actual porque sin el interruptor nunca se evalua"
          }
        ]
      },
