generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────

enum UserRole {
  TRADER
  ADMIN
}

enum Asset {
  BTC
  ETH
}

enum QuoteCurrency {
  USDT
  USDC
}

enum TradingMode {
  LIVE
  SANDBOX
  TESTNET
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum TradeType {
  BUY
  SELL
}

enum Decision {
  BUY
  SELL
  HOLD
}

enum IntervalMode {
  AGENT
  CUSTOM
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ── Spec 28 — Multi-Agent RAG ────────────────────────────────────────────────

enum AgentId {
  platform      // NEXUS  — Experto en CryptoTrader
  operations    // FORGE  — Asistente de Operaciones
  market        // SIGMA  — Analista de Mercado
  blockchain    // CIPHER — Experto en Blockchain
  risk          // AEGIS  — Gestor de Riesgo
  orchestrator  // KRYPTO — Orquestador central
  routing       // KRYPTO — Modelo rápido para clasificación de intención
  synthesis     // KRYPTO — Modelo principal para decisiones de trading
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}enum NotificationType {
  TRADE_EXECUTED
  STOP_LOSS_TRIGGERED
  TAKE_PROFIT_HIT
  AGENT_ERROR
  AGENT_STARTED
  AGENT_STOPPED
  AGENT_KILLED
  LLM_PROVIDER_DISABLED
}

enum LLMProvider {
  CLAUDE
  OPENAI
  GROQ
  GEMINI
  MISTRAL
  TOGETHER
  OPENROUTER
}

enum LLMSource {
  TRADING
  CHAT
  ANALYSIS
}

enum PricingSource {
  LIVE_OPENROUTER
  STALE_CACHE
  STATIC_TABLE
  UNPRICED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NewsApiProvider {
  CRYPTOPANIC
  NEWSDATA
  FINNHUB
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// ── Spec 42 — Agent Profit Optimizer ─────────────────────────────────────────

enum AgentOutcomeStatus {
  PENDING
  WIN
  LOSS
  NEUTRAL
  MISSED_OPPORTUNITY
  AVOIDED_LOSS
  NOT_EVALUABLE
}

// ── Spec 40 — Market Data Sources ────────────────────────────────────────────

enum PositionProtectionStatus {
  NONE
  PENDING
  PROTECTED
  UNPROTECTED
  RELEASED
}

enum PositionExitReason {
  LLM_SIGNAL
  LOSS_CUT
  STOP_LOSS
  TAKE_PROFIT
  TRAILING_STOP
  TIME_EXIT
  PARTIAL_TP
  EXCHANGE_STOP
  EXCHANGE_TAKE_PROFIT
  PROTECTION_FAILURE
  MANUAL
}

enum DataSourceCategory {
  TECHNICAL       // altFINS
  SENTIMENT       // Alternative.me
  DERIVATIVES     // Coinalyze
  DEFI_ONCHAIN    // DefiLlama
  NEWS            // Finnhub
  MARKET_DATA     // CoinGecko
  PREDICTION      // Polymarket
  TOKEN_UNLOCKS   // Messari
}

// ── Models ───────────────────────────────────────────────

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  role                  UserRole    @default(TRADER)
  isActive              Boolean     @default(true)
  platformOperationMode TradingMode @default(SANDBOX)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  binanceCredentials BinanceCredential[]
  llmCredentials     LLMCredential[]
  newsApiCredentials NewsApiCredential[]
  tradingConfigs    TradingConfig[]
  positions         Position[]
  trades            Trade[]
  agentDecisions    AgentDecision[]
  notifications     Notification[]
  adminActions      AdminAction[]      @relation("AdminActions")
  targetedActions   AdminAction[]      @relation("TargetedActions")
  chatSessions       ChatSession[]
  sandboxWallets    SandboxWallet[]
  newsConfig        NewsConfig?
  newsAnalyses      NewsAnalysis[]
  llmUsageLogs      LlmUsageLog[]
  agentConfigs      AgentConfig[]
  dataSourceCredentials DataSourceCredential[]
  budgetPolicy      AgentBudgetPolicy?
  decisionEvaluations AgentDecisionEvaluation[]
  riskPolicy        UserRiskPolicy?

  @@map("users")
}

model BinanceCredential {
  id              String   @id @default(cuid())
  userId          String
  isTestnet       Boolean  @default(false)
  apiKeyEncrypted String
  secretEncrypted String
  apiKeyIv        String
  secretIv        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isTestnet])
  @@map("binance_credentials")
}

model LLMCredential {
  id              String      @id @default(cuid())
  userId          String
  provider        LLMProvider
  apiKeyEncrypted String
  apiKeyIv        String
  selectedModel   String
  isActive        Boolean     @default(true)
  fallbackModels  String[]    @default([])
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("llm_credentials")
}

model NewsApiCredential {
  id              String          @id @default(cuid())
  userId          String
  provider        NewsApiProvider
  apiKeyEncrypted String
  apiKeyIv        String
  isActive        Boolean         @default(true)
  shared          Boolean         @default(false)
  createdAt       DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("news_api_credentials")
}

model TradingConfig {
  id                     String        @id @default(cuid())
  userId                 String
  name                   String        @default("")
  asset                  Asset
  pair                   QuoteCurrency
  buyThreshold           Float         @default(70)
  sellThreshold          Float         @default(70)
  stopLossPct            Float         @default(0.03)
  takeProfitPct          Float         @default(0.05)
  /// Minimum profit % required for LLM-driven SELL to execute (default 0.3%)
  minProfitPct           Float         @default(0.003)
  maxTradePct            Float         @default(0.05)
  maxConcurrentPositions Int           @default(2)
  minIntervalMinutes     Int           @default(5)
  intervalMode           IntervalMode  @default(AGENT)
  orderPriceOffsetPct    Float         @default(0)
  mode                   TradingMode   @default(SANDBOX)
  isRunning              Boolean       @default(false)
  /// Risk profile that influences LLM model selection and prompts
  riskProfile            RiskProfile   @default(MODERATE)
  lossCutEnabled                  Boolean @default(false)
  lossCutConfidenceThreshold      Float   @default(0.85)
  lossCutMinLossPct               Float   @default(0.005)
  lossCutMinEdgeRatio             Float   @default(2)
  smartSizingEnabled              Boolean @default(false)
  reduceSizeFactor                Float   @default(0.5)
  nativeProtectionEnabled         Boolean @default(false)
  closeOnProtectionFailure        Boolean @default(false)
  stopLimitOffsetPct              Float   @default(0.002)
  trailingStopEnabled             Boolean @default(false)
  trailingStopPct                 Float   @default(0.02)
  trailingActivationPct           Float   @default(0.01)
  partialTpEnabled                Boolean @default(false)
  partialTpTriggerPct             Float   @default(0.02)
  partialTpSellPct                Float   @default(0.5)
  moveStopToBreakevenAfterPartial Boolean @default(true)
  maxPositionHoldMinutes          Int?
  deterministicGateEnabled        Boolean @default(false)
  gatePriceChangePct              Float   @default(0.005)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]

  @@map("trading_configs")
}

model Position {
  id         String         @id @default(cuid())
  userId     String
  configId   String
  asset      Asset
  pair       QuoteCurrency
  mode       TradingMode
  entryPrice Float
  quantity   Float
  entryAt    DateTime       @default(now())
  exitPrice  Float?
  exitAt     DateTime?
  status     PositionStatus @default(OPEN)
  pnl        Float?
  fees       Float          @default(0)
  protectionStatus       PositionProtectionStatus @default(NONE)
  protectionOrderListId  String?
  protectionStopOrderId  String?
  protectionLimitOrderId String?
  protectionPlacedAt     DateTime?
  protectionFailureCount Int                      @default(0)
  protectionLastError    String?
  stopPrice              Float?
  takeProfitPrice        Float?
  highWaterPrice         Float?
  trailingActive         Boolean                  @default(false)
  initialQuantity        Float?
  partialExitCount       Int                      @default(0)
  realizedPnl            Float                    @default(0)
  exitReason             PositionExitReason?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  config TradingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId, status])
  @@index([userId, asset, status])
  @@index([userId, status, protectionStatus])
  @@map("positions")
}

model Trade {
  id             String      @id @default(cuid())
  userId         String
  positionId     String
  type           TradeType
  price          Float
  quantity       Float
  fee            Float
  executedAt     DateTime    @default(now())
  mode           TradingMode
  binanceOrderId String?
  decisionId     String?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  decision AgentDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, executedAt])
  @@index([userId, mode])
  @@index([decisionId])
  @@map("trades")
}

model UserRiskPolicy {
  id                    String    @id @default(cuid())
  userId                String    @unique
  enabled               Boolean   @default(false)
  maxAssetExposureUsd   Float?
  maxAssetExposurePct   Float?
  maxDailyLossUsd       Float?
  maxDrawdownPct        Float?
  pauseAgentsOnDrawdown Boolean   @default(true)
  pausedAt              DateTime?
  pausedReason          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_risk_policies")
}

model AgentDecision {
  id            String        @id @default(cuid())
  userId        String
  configId      String?
  configName    String?
  mode          TradingMode?
  asset         Asset
  pair          QuoteCurrency
  decision      Decision
  confidence    Float
  reasoning     String
  indicators    Json
  newsHeadlines Json
  waitMinutes   Int
  /// Orchestration metadata: { orchestrated: boolean, subAgentResults: SubAgentResult[] }
  metadata      Json?
  llmCostUsd          Float?
  llmCallCount        Int           @default(0)
  dataCostUsd         Float?
  expectedNetValueUsd Float?
  modelRoutingReason  String?
  createdAt     DateTime      @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("agent_decisions")
}

model NewsItem {
  id          String    @id @default(cuid())
  source      String
  headline    String
  url         String    @unique
  sentiment   Sentiment @default(NEUTRAL)
  publishedAt DateTime
  cachedAt    DateTime  @default(now())

  @@index([publishedAt])
  @@map("news_items")
}

/// User-level news fetching preferences
model NewsConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  intervalMinutes Int      @default(10)
  newsCount       Int      @default(15)
  enabledSources  String[] @default([])
  onlySummary     Boolean  @default(true)
  /// Whether the trading bot should include news analysis in its decisions
  botEnabled      Boolean  @default(true)
  /// Weight (0-100%) that news sentiment carries in the LLM trading decision
  newsWeight      Int      @default(15)

  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("news_configs")
}

/// Persisted news sentiment analysis (keyword-based + optional AI layer)
model NewsAnalysis {
  id               String    @id @default(cuid())
  userId           String
  analyzedAt       DateTime  @default(now())
  newsCount        Int
  positiveCount    Int
  negativeCount    Int
  neutralCount     Int
  score            Int
  overallSentiment String
  summary          String
  /// JSON array of {id,source,headline,sentiment,summary?,author?,publishedAt}
  headlines        Json

  // AI layer (null until user triggers AI analysis)
  aiAnalyzedAt       DateTime?
  aiProvider         String?
  aiModel            String?
  aiPositiveCount    Int?
  aiNegativeCount    Int?
  aiNeutralCount     Int?
  aiScore            Int?
  aiOverallSentiment String?
  aiSummary          String?
  /// JSON array of {id,sentiment,reasoning}
  aiHeadlines        Json?

  // Orchestration enrichment (Phase 28 — OrchestratorService.enrichNews)
  technicalRelevance  Float?
  ecosystemImpact     String?
  orchestratedTags    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, analyzedAt])
  @@map("news_analyses")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  admin  User  @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  target User? @relation("TargetedActions", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@map("admin_actions")
}

/// Global toggle for LLM providers — admin can enable/disable providers platform-wide.
/// Seeded with all LLMProvider enum values on first migration.
model PlatformLLMProvider {
  id        String      @id @default(cuid())
  provider  LLMProvider @unique
  isActive  Boolean     @default(true)
  updatedAt DateTime    @updatedAt
  updatedBy String?

  @@map("platform_llm_providers")
}

/// Virtual wallet for SANDBOX paper trading.
/// Created automatically on first agent start with 10,000 units each quote currency.
/// Updated atomically after every BUY / SELL so balance is always consistent.
model SandboxWallet {
  id        String        @id @default(cuid())
  userId    String
  currency  QuoteCurrency
  balance   Float         @default(10000)
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("sandbox_wallets")
}

model ChatSession {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New Chat")
  provider  LLMProvider?
  model     String?
  /// Agent assigned to this session. null = KRYPTO classifies on first message.
  agentId   AgentId? @map("agent_id")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        ChatRole
  content     String
  createdAt   DateTime @default(now())
  metadata    Json?
  /// For assistant messages: "PROVIDER:model" that generated this response
  generatedBy String?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ── Spec 28: Agent definitions (configurable by Admin) ───────────────────────

model AgentDefinition {
  id          AgentId  @id
  displayName String
  description String
  systemPrompt String  @db.Text
  skills      Json     // string[]
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  documents AgentDocument[]

  @@map("agent_definitions")
}

model AgentDocument {
  id          String         @id @default(cuid())
  agentId     AgentId
  title       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  status      DocumentStatus @default(PENDING)
  errorMsg    String?
  uploadedAt  DateTime       @default(now())
  processedAt DateTime?
  uploadedBy  String

  agent  AgentDefinition      @relation(fields: [agentId], references: [id])
  chunks AgentDocumentChunk[]

  @@index([agentId, status])
  @@map("agent_documents")
}

model LlmUsageLog {
  id            String         @id @default(cuid())
  userId        String
  provider      LLMProvider
  model         String
  inputTokens   Int
  outputTokens  Int
  costUsd       Float
  pricingSource PricingSource?
  source        LLMSource
  agentId       AgentId?
  decisionId    String?
  actualModel   String?
  requestId     String?
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, provider])
  @@index([agentId, createdAt])
  @@map("llm_usage_logs")
}

model AgentDocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  agentId    AgentId
  content    String  @db.Text
  chunkIndex Int
  /// Float[] stored as JSON — pgvector column added via raw migration
  embedding  Json

  document AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([documentId])
  @@map("agent_document_chunks")
}

// ── Spec 36: Agent Hub — per-agent LLM configuration ─────────────────────────

/// User-level agent config override (takes priority over admin defaults)
model AgentConfig {
  id        String      @id @default(cuid())
  userId    String
  agentId   AgentId
  provider  LLMProvider
  model     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@map("agent_configs")
}

/// Admin-level default config per agent (always OpenRouter)
model AdminAgentConfig {
  id        String      @id @default(cuid())
  agentId   AgentId     @unique
  provider  LLMProvider @default(OPENROUTER)
  model     String
  updatedAt DateTime    @updatedAt
  updatedBy String

  @@map("admin_agent_configs")
}

// ── Spec 40: Market Data Sources — platform-level config + user credentials ──

/// Platform-level data source configuration. Admin manages toggles and priorities.
model DataSourceConfig {
  id                String             @id @default(cuid())
  name              String             @unique            // e.g. "alternative_me"
  displayName       String                                // e.g. "Alternative.me — Fear & Greed Index"
  category          DataSourceCategory
  isActive          Boolean            @default(false)
  priority          Int                @default(1)        // higher = preferred
  targetAgents      String[]           @default([])       // AgentId values that benefit from this source
  requiresApiKey    Boolean            @default(false)
  baseUrl           String             @default("")
  rateLimitPerMin   Int                @default(60)
  pollingIntervalMs Int                @default(1800000)  // default 30min
  monthlyCostUsd    Float              @default(0)
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  lastErrorMessage  String?
  consecutiveErrors Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  credentials DataSourceCredential[]

  @@map("data_source_configs")
}

/// User-level API key for a data source (same pattern as LLMCredential).
model DataSourceCredential {
  id              String   @id @default(cuid())
  userId          String
  dataSourceId    String
  apiKeyEncrypted String
  apiKeyIv        String
  isActive        Boolean  @default(true)
  shared          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSource DataSourceConfig @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([userId, dataSourceId])
  @@map("data_source_credentials")
}

// ── Spec 42: Agent Profit Optimizer — telemetry & budget models ──────────────

model AgentBudgetPolicy {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dailyTokenBudget      Int      @default(200000)
  dailyUsdBudget        Float    @default(5)
  maxCostPerDecisionUsd Float    @default(0.15)
  livePremiumOnly       Boolean  @default(true)
  minEvToCostRatio      Float    @default(10)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_budget_policies")
}

model AgentDecisionEvaluation {
  id                   String             @id @default(cuid())
  decisionId           String
  userId               String
  horizonMinutes       Int
  status               AgentOutcomeStatus @default(PENDING)
  priceAtDecision      Float
  priceAtEvaluation    Float?
  realizedPnlUsd       Float?
  hypotheticalPnlUsd   Float?
  missedOpportunityUsd Float?
  maxAdverseMovePct    Float?
  maxFavorableMovePct  Float?
  marketRegime         String?
  evaluatedAt          DateTime?
  createdAt            DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decisionId, horizonMinutes])
  @@index([userId, decisionId])
  @@index([status, createdAt])
  @@map("agent_decision_evaluations")
}
