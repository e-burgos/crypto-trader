# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — validated at startup.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public"

# ── Seeding ───────────────────────────────────────────────────────────────────
# `prisma db seed` always provisions reference data (agents, LLM providers, data
# sources). The demo logins are provisioned only outside production. Set to
# "false" to skip them in a non-production environment; with NODE_ENV=production
# they are never provisioned and this flag cannot re-enable them.
SEED_DEMO_ACCOUNTS="true"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — the API refuses to start without it. There is no fallback secret.
JWT_SECRET="<generate-with: openssl rand -hex 64>"
# REQUIRED — the API refuses to start without it. There is no fallback secret.
JWT_REFRESH_SECRET="<generate-with: openssl rand -hex 64>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED — validated at startup.
# Must be exactly 32 characters for AES-256 encryption of Binance/LLM API keys
BINANCE_KEY_ENCRYPTION_KEY="replace-with-32-char-secret-key!"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:4200"

# ── Binance API URLs ──────────────────────────────────────────────────────────
# Override Binance endpoints (useful for geo-restricted regions like US)
# Public data (klines, ticker) — no geo-restrictions:
BINANCE_PUBLIC_URL="https://data-api.binance.vision"
# Authenticated requests (orders, account) — may be geo-restricted:
BINANCE_BASE_URL="https://api.binance.com"

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used by Vite (apps/web). Must be VITE_API_URL — NOT VITE_API_BASE_URL
VITE_API_URL="http://localhost:3000/api"

# ── Embeddings (RAG / Orchestrator) ──────────────────────────────────────────
# Required for the multi-agent RAG pipeline. Provide ONE of the two options:
# Option A — Voyage AI (voyage-3, 1024 dims) — preferred
VOYAGE_API_KEY="<voyage-ai-api-key>"
# Option B — OpenAI key reused for embeddings (text-embedding-3-small, 1536 dims)
# OPENAI_PLATFORM_KEY="<openai-api-key>"

# Number of reverse proxy hops in front of the API (Railway, nginx, Cloudflare…).
# Leave unset or 0 when the API is reachable directly: trusting hops that do not
# exist lets a client forge X-Forwarded-For and pick its own rate-limit bucket.
# Railway sits behind a single edge proxy, so production wants 1.
TRUST_PROXY_HOPS=0
